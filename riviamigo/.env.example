COMPOSE_REMOVE_ORPHANS=true

CF_TUNNEL_NAME=riviamigo
CF_TUNNEL_HOST=riviamigo.your.tld

HOSTNAME=riviamigo.your.tld

# Container timezone (logs). The timezone shown in the app is set under
# Settings > Units.
TZ=America/Phoenix

# Database and Redis passwords. Generate each with: openssl rand -hex 32
# (stick to hex; the values are interpolated into connection URLs)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Exact public HTTPS origin Riviamigo is served from. No path or trailing slash.
ALLOWED_ORIGINS=https://riviamigo.your.tld

# One-time proof needed to register the first owner account.
# Generate with: openssl rand -hex 32  (32+ bytes; a blank value fails startup)
# Once the owner exists, delete or comment out this line and recreate the app.
RIVIAMIGO_SETUP_TOKEN=

# Pocket ID as OIDC provider. In Pocket ID create an OIDC client with callback
# URL ${RIVIAMIGO_OIDC_PUBLIC_BASE_URL}/v1/auth/oidc/callback, then copy the
# client id/secret here. Values set here show as read-only in Settings >
# Authentication; the enable/disable toggles are left to the UI (see README).
RIVIAMIGO_OIDC_ISSUER_URL=https://pocket-id.your.tld
RIVIAMIGO_OIDC_PUBLIC_BASE_URL=https://riviamigo.your.tld
RIVIAMIGO_OIDC_CLIENT_ID=
RIVIAMIGO_OIDC_CLIENT_SECRET=
RIVIAMIGO_OIDC_BUTTON_LABEL='Sign in with Pocket ID'

# Break-glass: if SSO breaks after password login was turned off in the UI,
# uncomment both and run: docker compose up -d --no-deps --force-recreate riviamigo
#RIVIAMIGO_OIDC_ENABLED=false
#RIVIAMIGO_PASSWORD_LOGIN_ENABLED=true
