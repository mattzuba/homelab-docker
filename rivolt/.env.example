COMPOSE_REMOVE_ORPHANS=true

CF_TUNNEL_NAME=rivolt
CF_TUNNEL_HOST=rivolt.your.tld

HOSTNAME=rivolt.your.tld

ADDR=:8080
DATA_DIR=/data

# AI (Anthropic)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Auth. Public URL Rivolt is served from; the OIDC redirect URL is derived
# from it: ${RIVOLT_BASE_URL}/api/auth/oidc/pocketid/callback
RIVOLT_BASE_URL=https://rivolt.your.tld
# Generate with: openssl rand -hex 32  (empty = everyone logged out on restart)
RIVOLT_COOKIE_SECRET=
# Traffic arrives over HTTPS via Cloudflare
RIVOLT_SECURE_COOKIE=true
RIVOLT_TRUSTED_PROXY_CIDR=0.0.0.0/0

# Pocket ID as OIDC provider. In Pocket ID create an OIDC client with the
# callback URL above, then copy the client id/secret here.
RIVOLT_OIDC_PROVIDERS=pocketid
RIVOLT_OIDC_POCKETID_ISSUER=https://pocket-id.your.tld
RIVOLT_OIDC_POCKETID_CLIENT_ID=
RIVOLT_OIDC_POCKETID_CLIENT_SECRET=
RIVOLT_OIDC_POCKETID_DISPLAY_NAME='Pocket ID'
RIVOLT_OIDC_POCKETID_SCOPES=openid,email,profile

# Optional: Postgres instead of SQLite
DATABASE_URL=postgres://rivolt:rivolt@postgres:5432/rivolt?sslmode=disable
